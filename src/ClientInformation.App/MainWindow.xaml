<Window x:Class="ClientInformation.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        Loaded="Window_Loaded">

    <Window.Resources>

        <DropShadowEffect x:Key="TextShadow" Color="Black" ShadowDepth="1" BlurRadius="4" Opacity="0.9"/>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="10"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Foreground"   Value="#CCCCCC"/>
            <Setter Property="Margin"       Value="0,0,0,10"/>
            <Setter Property="FontFamily"   Value="Segoe UI"/>
            <Setter Property="Effect"       Value="{StaticResource TextShadow}"/>
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize"      Value="12"/>
            <Setter Property="Foreground"    Value="#DDDDDD"/>
            <Setter Property="FontFamily"    Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Effect"        Value="{StaticResource TextShadow}"/>
        </Style>

        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="FontSize"      Value="12"/>
            <Setter Property="FontWeight"    Value="SemiBold"/>
            <Setter Property="Foreground"    Value="#FFFFFF"/>
            <Setter Property="FontFamily"    Value="Segoe UI"/>
            <Setter Property="TextWrapping"  Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Effect"        Value="{StaticResource TextShadow}"/>
        </Style>

    </Window.Resources>

    <Border Background="Transparent" Margin="0">
        <StackPanel Margin="20,18,20,18" Width="500">

            <!-- Titel -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Rectangle Width="3" Height="18" Fill="#0078D4" RadiusX="2" RadiusY="2" Margin="0,0,10,0"/>
                <TextBlock Text="Client Information"
                           FontSize="15" FontWeight="Bold"
                           Foreground="White" FontFamily="Segoe UI"
                           VerticalAlignment="Center"
                           Effect="{StaticResource TextShadow}"/>
            </StackPanel>

            <!-- SYSTEM -->
            <TextBlock Text="SYSTEM" Style="{StaticResource CardTitle}"/>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="26"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Username"  Style="{StaticResource RowLabel}" Grid.Row="0" Grid.Column="0"/>
                <TextBlock x:Name="TxtUsername" Style="{StaticResource RowValue}"  Grid.Row="0" Grid.Column="1"/>

                <TextBlock Text="PC-Name"   Style="{StaticResource RowLabel}" Grid.Row="1" Grid.Column="0"/>
                <TextBlock x:Name="TxtPcName"   Style="{StaticResource RowValue}"  Grid.Row="1" Grid.Column="1"/>

                <TextBlock Text="Domain"    Style="{StaticResource RowLabel}" Grid.Row="2" Grid.Column="0"/>
                <TextBlock x:Name="TxtDomain"   Style="{StaticResource RowValue}"  Grid.Row="2" Grid.Column="1"/>
            </Grid>

            <Separator Background="#55FFFFFF" Margin="0,8,0,12"/>

            <!-- NETZWERK -->
            <TextBlock Text="NETZWERK" Style="{StaticResource CardTitle}"/>

            <ItemsControl x:Name="AdapterList" Margin="0,0,0,4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,10">
                            <!-- Adaptername als Überschrift -->
                            <TextBlock Style="{StaticResource CardTitle}"
                                       Margin="0,0,0,4">
                                <Run Text="{Binding AdapterName}"/>
                                <Run Text=" — "/>
                                <Run Text="{Binding Description}"/>
                            </TextBlock>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="26"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="IPv4" Style="{StaticResource RowLabel}" Grid.Row="0" Grid.Column="0"/>
                                <TextBlock Text="{Binding IPv4}" Style="{StaticResource RowValue}" Grid.Row="0" Grid.Column="1"/>

                                <TextBlock Text="MAC-Address" Style="{StaticResource RowLabel}" Grid.Row="1" Grid.Column="0"/>
                                <TextBlock Text="{Binding MacAddress}" Style="{StaticResource RowValue}"
                                           Grid.Row="1" Grid.Column="1" FontFamily="Consolas"/>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Separator Background="#33FFFFFF" Margin="0,4,0,12"/>

            <!-- EPM -->
            <TextBlock Text="EPM" Style="{StaticResource CardTitle}"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="26"/>
                </Grid.RowDefinitions>

                <TextBlock Text="EPM-Connection (TCP)" Style="{StaticResource RowLabel}" Grid.Row="0" Grid.Column="0"/>
                <TextBlock x:Name="TxtEpmConnection"   Style="{StaticResource RowValue}"  Grid.Row="0" Grid.Column="1"/>

                <TextBlock Text="EPM-Core"  Style="{StaticResource RowLabel}" Grid.Row="1" Grid.Column="0"/>
                <TextBlock x:Name="TxtEpmCore"   Style="{StaticResource RowValue}"  Grid.Row="1" Grid.Column="1"/>

                <TextBlock Text="EPM-Service" Style="{StaticResource RowLabel}" Grid.Row="2" Grid.Column="0"/>
                <TextBlock x:Name="TxtEpmService"  Style="{StaticResource RowValue}"  Grid.Row="2" Grid.Column="1"/>
            </Grid>

            <!-- Zeitstempel -->
            <TextBlock x:Name="TxtTimestamp"
                       Text="—"
                       FontSize="10" Foreground="#555555"
                       FontFamily="Segoe UI"
                       Margin="0,14,0,0"
                       HorizontalAlignment="Right"/>

        </StackPanel>
    </Border>

</Window>
